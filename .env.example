# DAIOF / HYPERAI environment template.
# Copy to `.env` (gitignored) and fill in real values locally.
# NEVER commit a filled-in .env. Rotate any secret that has been exposed.

# --- GitHub (primary; scripts run in dry-run mode if unset) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=Copilot-home/Alpha

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Datastores ---
DATABASE_URL=
REDIS_PASSWORD=

# --- Integrations ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
LINEAR_API_KEY=
VERCEL_TOKEN=
DOCKER_ORG_ACCESS_TOKEN=

# --- Observability ---
SENTRY_DSN=
GCLOUD_RW_API_KEY=

# --- Framework flags ---
HYPERAI_ALLOW_STUBS=1

[flake8]
max-line-length = 100
max-complexity = 10
extend-ignore = E203, W503
exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist,
    node_modules,
    metrics,
    logs,
    examples,
    .haios_snapshots,
    .consciousness,
    vscode,
    vscode-merged,
    vscode-python-environments,
    trust_of_copilot,
    DAIOF-Framework
